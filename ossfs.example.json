{
  "mount_point": "Z:",
  "bucket": "my-bucket",
  "endpoint": "https://oss-cn-shanghai.aliyuncs.com",
  "region": "cn-shanghai",
  "prefix": "",
  "force-path-style": false,
  "read-only": false,
  "uid": 0,
  "gid": 0,
  "dir-mode": "0755",
  "file-mode": "0644",
  "allow-other": false,
  "umask": "0022",
  "no-rename-dir": false,
  "rename-dir-limit": 2000000,
  "max-concurrent-requests": 32,
  "list-rate-limit": 0,
  "max-upload-bytes": 0,
  "read-ahead-bytes": 8388608,
  "no-ignore-fsync": false,
  "max-dirty-bytes": 0,
  "no-verify-crc64": false,
  "content-md5": false,
  "storage-class": "Standard",
  "multipart-size": 8388608,
  "multipart-concurrency": 4,
  "connect-timeout": 0,
  "readwrite-timeout": 0,
  "retries": 2,
  "notsup-compat-dir": false,
  "disk-cache-dir": "",
  "disk-cache-max-bytes": 0,
  "disk-cache-block-size": 4194304,
  "disk-cache-prefetch-blocks": 1,
  "disk-cache-prefetch-concurrency": 4,
  "disk-cache-verify-etag": false,
  "disk-cache-etag-ttl": 10,
  "disk-cache-reserve-diskfree": 0,
  "disk-cache-free-space-ratio": 0,
  "negative-cache-ttl": 5,
  "negative-cache-max-entries": 4096,
  "stat-cache-ttl": 3,
  "stat-cache-max-entries": 4096,
  "total-mem-limit": 0,
  "total-mem-read-ratio": 0.5,
  "read-cache-max-bytes": 67108864,
  "metrics-listen": "",
  "log-dir": "",
  "log-level": "info",
  "metrics-log-interval": 0,
  "access_key_id": "",
  "secret_access_key": ""
}
