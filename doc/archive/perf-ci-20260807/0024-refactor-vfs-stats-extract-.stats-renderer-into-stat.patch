 src/vfs/stats.rs        | 797 +--------------------------------------
 src/vfs/stats_render.rs | 806 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 808 insertions(+), 796 deletions(-)
 create mode 100644 src/vfs/stats_render.rs

