From 8fb17fb267081c97f4fb4eb384d21644a47da5bf Mon Sep 17 00:00:00 2001
From: codex <codex@local>
Date: Fri, 7 Aug 2026 12:29:53 +0800
Subject: [PATCH 28/29] ci: re-add perf-check for review-fixed stack

---
 .github/workflows/perf-check.yml | 45 ++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)
 create mode 100644 .github/workflows/perf-check.yml

diff --git a/.github/workflows/perf-check.yml b/.github/workflows/perf-check.yml
new file mode 100644
index 0000000..d183b96
--- /dev/null
+++ b/.github/workflows/perf-check.yml
@@ -0,0 +1,45 @@
+name: perf-check
+
+on:
+  push:
+    branches: [codex/perf-ci]
+
+jobs:
+  writeback-perf:
+    name: Writeback focused perf
+    runs-on: ubuntu-latest
+    timeout-minutes: 90
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Install system dependencies
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y protobuf-compiler pkg-config fuse3
+
+      - name: Enable FUSE
+        run: |
+          sudo modprobe fuse || true
+          sudo chmod 666 /dev/fuse || true
+
+      - name: Install Rust
+        uses: dtolnay/rust-toolchain@stable
+
+      - name: Run focused writeback throughput profile
+        env:
+          PERF_LOG_TO_CONSOLE: "false"
+          PERF_FIO_SIZE: "512m"
+          PERF_FIO_RUNTIME: "20"
+        run: |
+          bash docker/compose-xfstests/run_redis_perf.sh --s3 \
+            --writeback-throughput-profile \
+            --tools "fio-seqwrite fio-randwrite fio-randrw"
+
+      - name: Upload perf artifacts
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: perf-artifacts
+          path: docker/compose-xfstests/artifacts/
+          retention-days: 14
-- 
