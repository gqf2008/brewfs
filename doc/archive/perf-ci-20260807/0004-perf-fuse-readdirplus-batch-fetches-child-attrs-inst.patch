diff --git a/src/meta/client/mod.rs b/src/meta/client/mod.rs
index 410aa1d..4cbdd84 100644
--- a/src/meta/client/mod.rs
+++ b/src/meta/client/mod.rs
@@ -2147,6 +2147,45 @@ impl<T: MetaStore + ?Sized + 'static> MetaLayer for MetaClient<T> {
         self.cached_stat(ino).await
