<?xml version="1.0" encoding="utf-8"?>
<!--
  OSSFS application MSI (WiX v4/v5/v7).
  Installs the tray app and the ossmount binary side-by-side so the tray can
  find ossmount next to it. WinFsp itself is chained by ossfs-bundle.wxs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="OSSFS"
      Manufacturer="OSSFS"
      Version="$(var.Version)"
      UpgradeCode="6d2a7f0e-4c8e-4f3b-9a1b-8b2f3c4d5e6f"
      Scope="perMachine">
    <SummaryInformation
        Keywords="OSSFS;OSS;S3;WinFsp;挂载"
        Description="OSSFS 桌面托盘：把 S3/OSS bucket 直挂成本地盘符。"/>
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 OSSFS，请先卸载旧版本。" />
    <MediaTemplate EmbedCab="yes" />

    <!-- App binaries: tray + ossmount in the same folder. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OSSFS">
        <Directory Id="LicenseDir" Name="LICENSES" />
        <Component Id="C_TrayExe" Directory="INSTALLFOLDER">
          <File Id="F_TrayExe" Source="$(var.TrayPath)" KeyPath="yes" />
        </Component>
        <Component Id="C_OssmountExe" Directory="INSTALLFOLDER">
          <File Id="F_OssmountExe" Source="$(var.OssmountPath)" KeyPath="yes" />
        </Component>
        <Component Id="C_Readme" Directory="INSTALLFOLDER">
          <File Id="F_Readme" Source="$(var.ReadmePath)" KeyPath="yes" />
        </Component>
        <!-- Third-party license attribution. The WinFsp installer MSI is
             redistributed by the bundle (ossfs-bundle.wxs); WinFsp is GPLv3
             with a FLOSS exception whose terms require the copyright notice
             and repository link to accompany redistribution. -->
        <Component Id="C_LicensesReadme" Directory="LicenseDir">
          <File Id="F_LicensesReadme" Source="$(var.LicensesReadmePath)" KeyPath="yes" />
        </Component>
        <Component Id="C_WinfspLicense" Directory="LicenseDir">
          <File Id="F_WinfspLicense" Source="$(var.WinfspLicensePath)" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="OSSFSMenuFolder" Name="OSSFS">
        <Component Id="C_StartMenuShortcut" Directory="OSSFSMenuFolder">
          <Shortcut Id="S_Tray"
                    Name="OSSFS"
                    Description="OSSFS：OSS/S3 直挂为本地磁盘"
                    Target="[#F_TrayExe]"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="R_RemoveOSSFSMenuFolder" On="uninstall" />
          <!-- perMachine package: the KeyPath must be machine state (HKLM),
               not HKCU — a per-user hive key under a per-machine install
               fails ICE38/ICE43 checks and leaves the shortcut repairable
               only under the account that ran the installer. -->
          <RegistryValue Root="HKLM" Key="Software\OSSFS" Name="startMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Desktop shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="C_DesktopShortcut" Directory="DesktopFolder">
        <Shortcut Id="S_TrayDesktop"
                  Name="OSSFS"
                  Description="OSSFS：OSS/S3 直挂为本地磁盘"
                  Target="[#F_TrayExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\OSSFS" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="OSSFS" Level="1">
      <ComponentRef Id="C_TrayExe" />
      <ComponentRef Id="C_OssmountExe" />
      <ComponentRef Id="C_Readme" />
      <ComponentRef Id="C_LicensesReadme" />
      <ComponentRef Id="C_WinfspLicense" />
      <ComponentRef Id="C_StartMenuShortcut" />
      <ComponentRef Id="C_DesktopShortcut" />
    </Feature>
  </Package>
</Wix>